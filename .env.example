# ==============================================
# Vecta - Environment Variables Template
# ==============================================

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trellodb?schema=public"

# Redis (Caching, OTP & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Application Server
PORT=3000
WS_PORT=3002
BASE_URL="http://localhost:3000"
JWT_SECRET_TOKEN="your-super-secret-jwt-key"

# Transactional Email (Resend)
RESEND_API_KEY="re_your_resend_api_key_here"

# Cloud Storage (AWS S3)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
S3_BUCKET_NAME="vecta-s3"
