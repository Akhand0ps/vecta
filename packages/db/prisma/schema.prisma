// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {

  id String @id @default(uuid())
  username String @unique
  password String 


  memberships Membership[]
  issueMappings IssueMapping[]
  inviteby Invitation[]

  avatarFileId String?  @unique
  avatarFile StoredFile? @relation("UserAvatar",fields: [avatarFileId],references: [id])

  uploadedFiles StoredFile[] @relation("UserUploadedFiles")



  invitations Invitation[] @relation("invitationTarget")
  sessions Session[]
}



model Org{
  id String @id @default(uuid())
  name String 
  description String

  memberships Membership[]
  board Board[]
  
  invites Invitation[]

}

model Membership{

  id        String  @id @default(uuid())
  userId    String
  orgId     String  
  role      Role
  accepted  Boolean


  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  org  Org @relation(fields: [orgId],references: [id],onDelete: Cascade)

  @@unique([userId,orgId])

}

enum Role {
  MEMBER
  ADMIN
}


model Board{

  id String @id @default(uuid())
  title String
  orgId String 

  org Org @relation(fields: [orgId],references: [id],onDelete: Restrict)
  issues Issue[]
  sections Section[]

}

model Issue{

  id          String @id @default(uuid())
  title       String
  description String
  boardId     String 
  sectionId   String



  board Board @relation(fields: [boardId],references: [id],onDelete: Restrict)
  section Section @relation(fields: [sectionId],references: [id],onDelete: Restrict)
  comments Comment[]
  issueMappings IssueMapping[]


}

model Section{
  id String @id @default(uuid())
  title SectionType
  boardId String


  board Board @relation(fields: [boardId],references: [id],onDelete: Restrict)
  issues Issue[]
}

enum SectionType {
  IN_PROGRESS
  UPCOMING
  DONE
}

model Comment{
  id String @id @default(uuid())
  content String
  issueId String 


  issue Issue @relation(fields: [issueId],references: [id],onDelete: Cascade)
}

model IssueMapping{

  id String @id @default(uuid())
  userId String
  issueId String
  status AssignStatus @default(ACTIVE)


  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  issue Issue @relation(fields: [issueId],references: [id],onDelete: Cascade)

  @@unique([userId,issueId])
}

enum AssignStatus {

  ACTIVE
  INACTIVE
}


model Invitation {


  id String @id @default(uuid())

  username String
  userId  String
  tokenHash String @unique


  orgId String
  inviteById String

  expiresAt DateTime
  acceptedAt DateTime?

  revoked Boolean @default(false)
  revokedAt DateTime?

  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId],references: [id])

  invitedBy User @relation(fields: [inviteById],references: [id])
  user User @relation("invitationTarget",fields:[userId],references:[id])
}

model Session {
  id String @id @default(uuid())


  tokenHash String @unique

  userId String 

  expiresAt DateTime

  createdAt DateTime @default(now())


  user User @relation(fields: [userId],references: [id])
} 


model StoredFile {
  id String @id @default(uuid())

  key String @unique
  originalName String
  mimeType String
  size Int


  avatarof User? @relation("UserAvatar")


  uploadedById String
  uploadedBy User @relation("UserUploadedFiles",fields: [uploadedById],references: [id])
  



  createdAt DateTime @default(now())

  @@index([key])
  @@index([uploadedById])
}